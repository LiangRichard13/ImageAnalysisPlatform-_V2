# 分析系统环境配置模板
# 使用方法：复制本文件为 .env 并按需修改（.env 不入仓库）

# 模型权重路径（默认 core/ 下对应方法目录的 weights/，一般无需配置）
# ANOMALY_MODEL_PATH=
# TREND_MODEL_PATH=

# 检测数据根目录（默认 download/，其下按 原有结构分组：
#   anomaly_api/input/{时间戳}/（原图+request.json） + anomaly_api/output/{时间戳}/（三件套）
#   trend_api/input/{时间戳}/（序列原图）          + trend_api/output/{时间戳}/（prediction+json））
# DOWNLOAD_ROOT_DIR=

# 在线批处理监控路径（仅作为首次启动的默认值，之后以界面选择并记忆的路径为准）
# ONLINE_PROCESSING_AD_DIR=G:\TestImg\2026-09-09(10.03)

# 异常警告弹窗自动关闭时长（毫秒），0 表示不自动关闭（手动点击关闭）
ANOMALY_ALERT_AUTO_CLOSE_MS=5000
